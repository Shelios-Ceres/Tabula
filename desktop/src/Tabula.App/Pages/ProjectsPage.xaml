<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tabula.App.Pages.ProjectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:Tabula.App.Pages"
    Background="Transparent">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="Find_Invoked" />
    </Page.KeyboardAccelerators>
    <Page.Resources>
        <DataTemplate x:Key="NewCanvasTemplate" x:DataType="pages:ProjectTile">
            <Grid Width="260" Height="220" CornerRadius="14"
                  Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1.5"
                  AutomationProperties.Name="新建画布">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <Border Width="40" Height="40" CornerRadius="20" HorizontalAlignment="Center"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <FontIcon Glyph="&#xE710;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                    <TextBlock Text="新建画布" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="Ctrl+N" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="CanvasCardTemplate" x:DataType="pages:ProjectTile">
            <!-- Windows 11 card over the window acrylic; empty canvases get a colourful cover from the kind palette. -->
            <Grid Width="260" Height="220" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" AutomationProperties.Name="{x:Bind Title}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Background="{x:Bind pages:ProjectsPage.CoverBrush(Id)}">
                    <FontIcon Glyph="&#xE790;" FontSize="32" Foreground="White" Opacity="0.9" />
                    <Image Source="{x:Bind pages:ProjectsPage.Cover(CoverPath)}" Stretch="UniformToFill" />
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="8,3" CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            Visibility="{x:Bind PendingVisibility}">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind PendingText}" FontSize="11" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid Grid.Row="1" Padding="14,12" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind StatsText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource ToolbarButton}" Padding="8,6" VerticalAlignment="Center" Click="More_Click"
                            ToolTipService.ToolTip="更多操作" AutomationProperties.Name="更多操作">
                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                    </Button>
                </Grid>
            </Grid>
        </DataTemplate>
        <pages:ProjectTileSelector x:Key="TileSelector"
                                   NewTemplate="{StaticResource NewCanvasTemplate}"
                                   CardTemplate="{StaticResource CanvasCardTemplate}" />
    </Page.Resources>

    <Grid Padding="32,8,32,24" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="8" Padding="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="我的画布" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="Summary" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
            <TextBox x:Name="SearchBox" Grid.Column="1" Width="220" PlaceholderText="搜索画布" VerticalAlignment="Bottom"
                     AutomationProperties.Name="搜索画布" TextChanged="Search_Changed" KeyDown="Search_KeyDown" />
            <Button Grid.Column="2" Style="{StaticResource ActionButton}" Click="Settings_Click" VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                    <TextBlock Text="设置" />
                </StackPanel>
            </Button>
            <Button Grid.Column="3" Style="{StaticResource AccentActionButton}" Click="Create_Click" VerticalAlignment="Bottom">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="N" />
                </Button.KeyboardAccelerators>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="新建画布" />
                </StackPanel>
            </Button>
        </Grid>

        <GridView x:Name="Projects" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True"
                  ItemClick="Projects_ItemClick" ContextRequested="Projects_ContextRequested"
                  ItemTemplateSelector="{StaticResource TileSelector}" Padding="0">
            <GridView.Resources>
                <!-- The item hover plate reads this resource, not GridViewItem.CornerRadius; match the card corners. -->
                <CornerRadius x:Key="GridViewItemCornerRadius">14</CornerRadius>
            </GridView.Resources>
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                    <Setter Property="Margin" Value="0,0,16,16" />
                </Style>
            </GridView.ItemContainerStyle>
        </GridView>

        <StackPanel x:Name="Empty" Grid.Row="1" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <Image Source="ms-appx:///Assets/Logo.png" Width="72" Height="72" HorizontalAlignment="Center" />
            <TextBlock Text="还没有画布，新建一个开始创作吧" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Style="{StaticResource AccentActionButton}" Content="新建画布" HorizontalAlignment="Center" Click="Create_Click" />
        </StackPanel>

        <StackPanel x:Name="SearchEmpty" Grid.Row="1" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock x:Name="SearchEmptyText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
            <Button Style="{StaticResource ActionButton}" Content="清空搜索" HorizontalAlignment="Center" Click="ClearSearch_Click" />
        </StackPanel>
    </Grid>
</Page>
