<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tabula.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:Tabula.App.Pages"
    Background="Transparent">
    <Grid Padding="24,8,24,24" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left section navigation rail -->
        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Style="{StaticResource ToolbarButton}" Padding="10,7" Click="Back_Click" ToolTipService.ToolTip="返回" AutomationProperties.Name="返回">
                    <FontIcon Glyph="&#xE76B;" FontSize="15" />
                </Button>
                <TextBlock Text="设置" Style="{StaticResource PageTitle}" />
            </StackPanel>
            <ListView x:Name="NavList" Grid.Row="1" SelectionMode="Single" SelectionChanged="NavList_SelectionChanged">
                <ListViewItem Tag="vendors" AutomationProperties.Name="服务商">
                    <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,4">
                        <FontIcon Glyph="&#xE8D7;" FontSize="15" />
                        <TextBlock Text="服务商" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Tag="defaults" AutomationProperties.Name="默认模型">
                    <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,4">
                        <FontIcon Glyph="&#xE8B9;" FontSize="15" />
                        <TextBlock Text="默认模型" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Tag="generation" AutomationProperties.Name="生成">
                    <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,4">
                        <FontIcon Glyph="&#xE945;" FontSize="15" />
                        <TextBlock Text="生成" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Tag="agents" AutomationProperties.Name="助手">
                    <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,4">
                        <FontIcon Glyph="&#xE99A;" FontSize="15" />
                        <TextBlock Text="助手" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Tag="external" AutomationProperties.Name="外部连接">
                    <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,4">
                        <FontIcon Glyph="&#xE968;" FontSize="15" />
                        <TextBlock Text="外部连接" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Tag="appearance" AutomationProperties.Name="外观">
                    <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,4">
                        <FontIcon Glyph="&#xE771;" FontSize="15" />
                        <TextBlock Text="外观" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Tag="data" AutomationProperties.Name="数据与安全">
                    <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,4">
                        <FontIcon Glyph="&#xE72E;" FontSize="15" />
                        <TextBlock Text="数据与安全" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Tag="about" AutomationProperties.Name="关于">
                    <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,4">
                        <FontIcon Glyph="&#xE946;" FontSize="15" />
                        <TextBlock Text="关于" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
            </ListView>
        </Grid>

        <!-- Right section content area -->
        <ScrollViewer x:Name="ContentScroller" Grid.Column="1">
            <Grid Padding="0,8,24,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="820" />
                </Grid.ColumnDefinitions>

                <!-- 1. 服务商 -->
                <StackPanel x:Name="VendorsSection" Spacing="16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="服务商" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap"
                                       Text="添加 OpenAI、Google Gemini、火山方舟、xAI、千问或 MiniMax，填入 API Key 后即可在画布里生成。请求由客户端直接发往各家原生接口。" />
                        </StackPanel>
                        <Button x:Name="AddVendorButton" Grid.Column="1" Style="{StaticResource AccentActionButton}" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="13" />
                                <TextBlock Text="添加服务商" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout x:Name="VendorMenu" Placement="BottomEdgeAlignedRight" />
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <GridView x:Name="ChannelList" SelectionMode="Single" SelectionChanged="ChannelList_SelectionChanged" Padding="0">
                        <GridView.Resources>
                            <CornerRadius x:Key="GridViewItemCornerRadius">12</CornerRadius>
                        </GridView.Resources>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                                <Setter Property="Margin" Value="0,0,8,8" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="pages:ChannelRow">
                                <Border Width="182" Padding="12,10" CornerRadius="12"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        AutomationProperties.Name="{x:Bind Name}">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="24" Height="24" CornerRadius="6" Background="{x:Bind BadgeBrush}">
                                                <TextBlock Text="{x:Bind Badge}" FontSize="12" FontWeight="SemiBold" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                            <FontIcon Grid.Column="2" Glyph="&#xE7BA;" FontSize="11" VerticalAlignment="Center"
                                                      Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind MissingKey}" />
                                            <Ellipse Grid.Column="2" Width="7" Height="7" VerticalAlignment="Center"
                                                     Fill="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind HasKey}" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource SecondaryCaption}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <Border x:Name="NoChannelCard" Style="{StaticResource SectionCard}" Padding="32" Visibility="Collapsed">
                        <StackPanel Spacing="10" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8D7;" FontSize="32" Foreground="{ThemeResource KindVideoBrush}" />
                            <TextBlock Text="还没有服务商" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                            <TextBlock Text="添加 OpenAI、Google Gemini、火山方舟、xAI、千问或 MiniMax，填入 API Key 后即可在画布里生成" Style="{StaticResource SecondaryCaption}"
                                       TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                            <Button Style="{StaticResource AccentActionButton}" Content="添加服务商" HorizontalAlignment="Center" Click="AddChannelButton_Click" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="EditorCard" Style="{StaticResource SectionCard}">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="EditorBadgeBorder" Width="28" Height="28" CornerRadius="6" Background="{ThemeResource KindVideoBrush}">
                                    <TextBlock x:Name="EditorBadgeText" FontSize="13" FontWeight="SemiBold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="EditorTitle" Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Click="DeleteChannel_Click" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Style="{StaticResource ToolbarButton}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                        <TextBlock Text="删除此服务商" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <SelectorBar x:Name="VendorSubBar" SelectionChanged="VendorSubBar_Changed" Margin="-8,0,0,0">
                                <SelectorBarItem x:Name="ConnectTabItem" Text="连接" IsSelected="True" />
                                <SelectorBarItem x:Name="ModelsTabItem" Text="模型" />
                                <SelectorBarItem x:Name="BillingTabItem" Text="额度" />
                            </SelectorBar>

                            <!-- Sub-tab 1: 连接 -->
                            <StackPanel x:Name="ConnectTab" Spacing="14">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="BaseUrlBox" Header="接口地址（只填域名，版本路径自动拼接）" TextChanged="Field_Changed" />
                                    <ComboBox x:Name="VersionBox" Grid.Column="1" Header="接口版本" Width="120" SelectionChanged="Field_Changed">
                                        <x:String>v1beta</x:String>
                                        <x:String>v1</x:String>
                                    </ComboBox>
                                    <ComboBox x:Name="SiteBox" Grid.Column="1" Header="站点" Width="120" AutomationProperties.Name="接口站点" SelectionChanged="Site_Changed">
                                        <x:String>中国大陆</x:String>
                                        <x:String>国际</x:String>
                                    </ComboBox>
                                </Grid>
                                <PasswordBox x:Name="KeyBox" Header="API Key" PlaceholderText="粘贴服务商控制台里的 API Key" PasswordChanged="Field_Changed" />
                                <InfoBar x:Name="KeyWarning" Severity="Warning" IsClosable="False" Title="还没有填写 API Key" Message="填写后才能用这家服务商生成；Key 用 Windows 数据保护（DPAPI）加密保存在本机。" />
                                <StackPanel Spacing="4">
                                    <NumberBox x:Name="ConcurrencyBox" Header="同时请求上限" Minimum="1" SpinButtonPlacementMode="Compact" PlaceholderText="不限" HorizontalAlignment="Left" Width="160" AutomationProperties.Name="同时请求上限" ValueChanged="Concurrency_Changed" />
                                    <TextBlock Text="同一服务商在所有画布里同时发出的图片请求数，4K 的一个请求算 2 个，其余排队。留空表示不限。" Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock x:Name="ApiHint" Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Sub-tab 2: 模型 -->
                            <StackPanel x:Name="ModelsTab" Spacing="12" Visibility="Collapsed">
                                <Grid>
                                    <TextBlock Text="模型按家族识别能力；显示名称留空时用自动简化的名字，实际请求仍用完整型号。" Style="{StaticResource SecondaryCaption}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                        <Button x:Name="FetchButton" Style="{StaticResource ToolbarButton}" Click="FetchModels_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE895;" FontSize="13" />
                                                <TextBlock x:Name="FetchText" Text="拉取模型列表" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource ToolbarButton}" Click="Recommended_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE734;" FontSize="13" />
                                                <TextBlock Text="添加推荐模型" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <StackPanel x:Name="ModelRows" Spacing="6" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="NewModelBox" PlaceholderText="手动输入模型名称，例如 gpt-image-2" KeyDown="NewModelBox_KeyDown" />
                                    <TextBox x:Name="NewEndpointBox" Grid.Column="1" Width="220" PlaceholderText="推理接入点 ep-（可选）" KeyDown="NewModelBox_KeyDown"
                                             AutomationProperties.Name="推理接入点" Visibility="Collapsed" />
                                    <Button Grid.Column="2" Style="{StaticResource ActionButton}" Content="添加" Click="AddModel_Click" />
                                </Grid>
                            </StackPanel>

                            <!-- Sub-tab 3: 额度 -->
                            <StackPanel x:Name="BillingTab" Spacing="12" Visibility="Collapsed">
                                <TextBlock x:Name="UsageText" TextWrapping="Wrap" />
                                <TextBlock x:Name="TokenText" Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap" />
                                <TextBlock x:Name="EstimateText" TextWrapping="Wrap" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="BillingHint" Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap" />
                                <StackPanel x:Name="PriceRows" Spacing="8" />
                                <Grid x:Name="BillingFields" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="BillingIdBox" TextChanged="Billing_Changed" />
                                    <PasswordBox x:Name="BillingKeyBox" Grid.Column="1" PasswordChanged="Billing_Changed" />
                                </Grid>
                                <StackPanel x:Name="BalanceRow" Orientation="Horizontal" Spacing="12">
                                    <Button x:Name="BalanceButton" Style="{StaticResource ActionButton}" Content="查询余额" Click="Balance_Click" />
                                    <TextBlock x:Name="BalanceText" VerticalAlignment="Center" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 2. 默认模型 -->
                <StackPanel x:Name="DefaultsSection" Spacing="16" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="默认模型" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap"
                                   Text="新开的指令栏和新建的配方节点先用这些模型，之后在指令栏里随时可换。" />
                    </StackPanel>
                    <Border Style="{StaticResource SectionCard}">
                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <ComboBox x:Name="ImageDefault" Header="图片" HorizontalAlignment="Stretch" SelectionChanged="Default_Changed" Tag="Image" />
                            <ComboBox x:Name="TextDefault" Grid.Column="1" Header="文本" HorizontalAlignment="Stretch" SelectionChanged="Default_Changed" Tag="Text" />
                            <ComboBox x:Name="AudioDefault" Grid.Row="1" Header="音频" HorizontalAlignment="Stretch" SelectionChanged="Default_Changed" Tag="Audio" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="文本模型系统提示词（可选）" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="生成文本和反推提示词时放在最前面。" Style="{StaticResource SecondaryCaption}" />
                            <TextBox x:Name="SystemPromptBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100"
                                     PlaceholderText="例如：用简体中文回答，提示词写成逗号分隔的短语" AutomationProperties.Name="文本模型系统提示词" TextChanged="SystemPrompt_Changed" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 3. 生成 -->
                <StackPanel x:Name="GenerationSection" Spacing="16" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="生成" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap"
                                   Text="影响所有画布的生成等待动画、参考图与排队行为。" />
                    </StackPanel>
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel Spacing="14">
                            <ToggleSwitch x:Name="WaitingAnimationsSwitch" Header="播放生成等待动画" OnContent="开启" OffContent="关闭" Toggled="WaitingAnimations_Toggled" />
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource SecondaryCaption}"
                                       Text="图片生成时，节点里会随机播放文件夹中的一幅网页动画（.html），首次使用时会装入客户端自带的原创动画。可以自己增删，子文件夹里的不会播放；关闭动画或清空文件夹后显示转圈。" />
                            <Button Style="{StaticResource ActionButton}" Content="打开等待动画文件夹" Click="OpenLoaders_Click" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="排队与参考图" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap"
                                       Text="• 参考图超过服务商官方上限时会自动压缩到上限以内，并在说明中标注。&#x0A;• 每个服务商的同时请求上限在「服务商 › 连接」里设置；超过上限的请求自动排队，排队不算失败。" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 4. 助手 -->
                <StackPanel x:Name="AgentsSection" Spacing="16" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="助手" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap"
                                   Text="画布里的「助手」会通过 ACP（Agent Client Protocol）启动本机的 Agent，并把画布工具交给它使用。需要先装好对应的 Agent 并在终端里登录过；启动命令可以改成本机的实际路径。" />
                    </StackPanel>
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel x:Name="AgentList" Spacing="12" />
                    </Border>
                </StackPanel>

                <!-- 5. 外部连接 -->
                <StackPanel x:Name="ExternalSection" Spacing="16" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="外部连接" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap"
                                   Text="开启后，客户端外的 Agent（如终端里的 Claude Code、Kimi、Grok）可以操作当前打开的画布：把下面的命令登记为它们的 MCP 服务器即可。只有你自己 Windows 账户下的程序能连接，不开放网络端口。" />
                    </StackPanel>
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel Spacing="14">
                            <ToggleSwitch x:Name="ExternalAgentsSwitch" Header="允许外部 Agent 连接" OnContent="开启" OffContent="关闭" Toggled="ExternalAgents_Toggled" />
                            <StackPanel Spacing="6">
                                <TextBlock Text="MCP 启动命令" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="BridgeCommand" IsReadOnly="True" FontFamily="Consolas" AutomationProperties.Name="外部 Agent 的 MCP 启动命令" />
                                    <Button x:Name="CopyBridgeButton" Grid.Column="1" Style="{StaticResource ActionButton}" Click="CopyBridge_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                            <TextBlock x:Name="CopyBridgeText" Text="复制" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="外部 Agent 能做什么" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap"
                                       Text="读取画布和图片、增删改节点与连线、发起生成并等待结果、拼版、对比图片差异、管理当前画布的资料库、替换节点里的文件以及查询用量。每次修改只记一步撤销。" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 6. 外观 -->
                <StackPanel x:Name="AppearanceSection" Spacing="16" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="外观" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap"
                                   Text="材质、画布底色、主题与界面缩放，切换后立即生效。" />
                    </StackPanel>
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel Spacing="14">
                            <RadioButtons x:Name="MaterialList" Header="玻璃材质" MaxColumns="3" AutomationProperties.Name="玻璃材质" SelectionChanged="Material_Changed">
                                <x:String>磨砂</x:String>
                                <x:String>液态</x:String>
                                <x:String>亚克力</x:String>
                            </RadioButtons>
                            <TextBlock Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap"
                                       Text="磨砂是默认的薄玻璃：半透明填充加强背景模糊。液态是带折射的着色器玻璃，参数可实时微调。亚克力是 Windows 自带的材质。" />
                            <Button x:Name="TuningButton" Style="{StaticResource ActionButton}" Content="调整液态玻璃参数…" Click="Tuning_Click" />
                            <RadioButtons x:Name="GroundList" Header="画布底色" MaxColumns="4" AutomationProperties.Name="画布底色" SelectionChanged="Ground_Changed" />
                            <RadioButtons x:Name="ThemeList" Header="主题" MaxColumns="3" AutomationProperties.Name="主题" SelectionChanged="Theme_Changed">
                                <x:String>跟随系统</x:String>
                                <x:String>浅色</x:String>
                                <x:String>深色</x:String>
                            </RadioButtons>
                            <StackPanel Spacing="4">
                                <Grid>
                                    <TextBlock Text="界面缩放（画布上的浮动工具栏和面板）" />
                                    <TextBlock x:Name="ScaleValueText" HorizontalAlignment="Right" Style="{StaticResource SecondaryCaption}" />
                                </Grid>
                                <Slider x:Name="ScaleSlider" Minimum="0.75" Maximum="2" StepFrequency="0.05" AutomationProperties.Name="界面缩放" ValueChanged="Scale_Changed" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 7. 数据与安全 -->
                <StackPanel x:Name="DataSection" Spacing="16" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="数据与安全" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap"
                                   Text="画布、图片、视频和设置都只保存在本机，不会上传到任何服务器。" />
                    </StackPanel>
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="本地数据目录" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="DataPath" VerticalAlignment="Center" IsTextSelectionEnabled="True" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <Button Style="{StaticResource ActionButton}" Content="打开文件夹" Click="OpenData_Click" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource SecondaryCaption}"
                                       Text="• API Key 与查账凭据使用 Windows 数据保护（DPAPI）按当前用户加密保存。&#x0A;• 生成请求由客户端直接发往各服务商，走系统代理设置。&#x0A;• 未处理的异常记录在数据目录的 crash.log。" />
                        </StackPanel>
