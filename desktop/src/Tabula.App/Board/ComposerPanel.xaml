<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Tabula.App.Board.ComposerPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:board="using:Tabula.App.Board">
    <!-- Unified pill design: every single-line capsule is Height=36, CornerRadius=18, FontSize=13, GlassCapsule material. -->
    <Grid x:Name="Shell" Width="820">

        <!-- ==================== VIEW 1: POST-GENERATION INFO BAR (图片/成品信息框) ==================== -->
        <StackPanel x:Name="InspectView" Spacing="8" Visibility="Collapsed">
            <!-- Original references used to produce this output (only when wired upstream exists). -->
            <board:WrapPanel x:Name="InspectRefsRow" HorizontalSpacing="6" VerticalSpacing="6" Visibility="Collapsed" />

            <!-- Original prompt used to generate this output (read-only selectable + one-click copy). -->
            <Border x:Name="InspectPromptCapsule" Style="{StaticResource GlassCapsule}" CornerRadius="18" Padding="14,7,6,7" Visibility="Collapsed">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer MaxHeight="84" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                        <TextBlock x:Name="InspectPromptText" AutomationProperties.Name="原生成提示词" FontSize="13" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" VerticalAlignment="Center" />
                    </ScrollViewer>
                    <Button x:Name="CopyPromptButton" Grid.Column="1" Style="{StaticResource ToolbarButton}" Width="28" Height="28" MinHeight="0" Padding="0"
                            CornerRadius="14" VerticalAlignment="Center" Click="CopyPrompt_Click"
                            ToolTipService.ToolTip="复制这段提示词" AutomationProperties.Name="复制提示词">
                        <FontIcon x:Name="CopyPromptIcon" Glyph="&#xE8C8;" FontSize="13" />
                    </Button>
                </Grid>
            </Border>

            <!-- Bottom row: unified Height=36 metadata pills on the left, action pills on the right. -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <board:WrapPanel HorizontalSpacing="6" VerticalSpacing="6" VerticalAlignment="Center">
                    <Border x:Name="InspectTitleCapsule" Style="{StaticResource GlassCapsule}" Height="36" CornerRadius="18" Padding="12,0">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <FontIcon x:Name="InspectKindIcon" Glyph="&#xEB9F;" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock x:Name="InspectPrimaryText" AutomationProperties.Name="图片信息" FontSize="13" FontWeight="SemiBold"
                                       MaxWidth="260" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="InspectSpecCapsule" Style="{StaticResource GlassCapsule}" Height="36" CornerRadius="18" Padding="12,0" Visibility="Collapsed">
                        <TextBlock x:Name="InspectSpecText" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   MaxWidth="260" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Border>
                    <Border x:Name="InspectNotesCapsule" Style="{StaticResource GlassCapsule}" Width="36" Height="36" CornerRadius="18" Padding="0" Visibility="Collapsed">
                        <Button x:Name="InspectNotesButton" Style="{StaticResource ToolbarButton}" Width="34" Height="34" MinHeight="0" Padding="0" CornerRadius="17"
                                AutomationProperties.Name="模型说明与识别文字">
                            <FontIcon Glyph="&#xE946;" FontSize="13" />
                        </Button>
                    </Border>
                </board:WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Border x:Name="InspectReuseCapsule" Style="{StaticResource GlassCapsule}" Height="36" CornerRadius="18" Padding="2" Visibility="Collapsed">
                        <Button x:Name="InspectReuseButton" Style="{StaticResource ToolbarButton}" Height="30" MinHeight="0" Padding="12,0" CornerRadius="15" Click="InspectReuse_Click"
                                ToolTipService.ToolTip="沿用这张图的提示词、模型和参数再生成" AutomationProperties.Name="沿用设置">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                <TextBlock Text="沿用设置" FontSize="13" />
                            </StackPanel>
                        </Button>
                    </Border>
                    <Border x:Name="InspectComposeCapsule" Style="{StaticResource GlassCapsule}" Height="36" CornerRadius="18" Padding="2" Visibility="Collapsed">
                        <Button x:Name="InspectComposeButton" Style="{StaticResource ToolbarButton}" Height="30" MinHeight="0" Padding="14,0" CornerRadius="15"
                                AllowFocusOnInteraction="False" Click="StartCompose_Click" AutomationProperties.Name="以此图生图">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE945;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="InspectComposeText" Text="以此图生图" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Button>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- ==================== VIEW 2: PRE-GENERATION COMPOSER (生成参数框) ==================== -->
        <StackPanel x:Name="ComposeView" Spacing="8" Visibility="Collapsed">
            <!-- Row 1 (on demand): missing-key hint or local-edit marks as unified Height=36 pills. -->
            <board:WrapPanel x:Name="InfoRow" HorizontalSpacing="6" VerticalSpacing="6" Visibility="Collapsed">
                <Border x:Name="HintCapsule" Style="{StaticResource GlassCapsule}" Height="36" CornerRadius="18" Padding="12,0,8,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="HintText" FontSize="13" VerticalAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Style="{StaticResource ToolbarButton}" Height="26" MinHeight="0" Padding="8,0" CornerRadius="13" Click="OpenSettings_Click" AutomationProperties.Name="去设置">
                            <TextBlock Text="去设置" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Button>
                    </StackPanel>
                </Border>
                <Border x:Name="MarksCapsule" Style="{StaticResource GlassCapsule}" Height="36" CornerRadius="18" Padding="12,0,8,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock x:Name="MarksText" FontSize="13" VerticalAlignment="Center" MaxWidth="340" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <Button Style="{StaticResource ToolbarButton}" Height="26" MinHeight="0" Padding="8,0" CornerRadius="13" Click="ClearMarks_Click" AutomationProperties.Name="清除标注">
                            <TextBlock Text="清除标注" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Border>
            </board:WrapPanel>

            <!-- Row 2: back-to-info pill (when opened from an existing image), wrapping reference pills, + 添加, placement hint, A/B toggle. -->
            <ScrollViewer MaxHeight="120" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
                <board:WrapPanel x:Name="RefChips" HorizontalSpacing="6" VerticalSpacing="6">
                    <Border x:Name="BackInfoCapsule" Style="{StaticResource GlassCapsule}" Height="36" CornerRadius="18" Padding="2" Visibility="Collapsed">
                        <Button Style="{StaticResource ToolbarButton}" Height="30" MinHeight="0" Padding="10,0" CornerRadius="15" Click="BackToInfo_Click"
                                ToolTipService.ToolTip="返回查看所选图片信息" AutomationProperties.Name="返回图片信息">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE72B;" FontSize="12" />
                                <TextBlock Text="图片信息" FontSize="13" />
                            </StackPanel>
                        </Button>
                    </Border>
                    <Border x:Name="AddCapsule" Style="{StaticResource GlassCapsule}" Height="36" CornerRadius="18" Padding="2">
                        <Button x:Name="AddButton" Style="{StaticResource ToolbarButton}" Height="30" MinHeight="0" Padding="12,0" CornerRadius="15"
                                AutomationProperties.Name="添加参考" ToolTipService.ToolTip="从资料库或文件添加参考">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE710;" FontSize="13" />
                                <TextBlock Text="添加" FontSize="13" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout x:Name="AddMenu" Placement="Top" Opening="AddMenu_Opening" />
                            </Button.Flyout>
                        </Button>
                    </Border>
                    <Border x:Name="TargetCapsule" Style="{StaticResource GlassCapsule}" Height="36" CornerRadius="18" Padding="12,0">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8AD;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="TargetText" AutomationProperties.Name="结果去向" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                        </StackPanel>
                    </Border>
                </board:WrapPanel>
            </ScrollViewer>

            <!-- Row 3: prompt input capsule matching the same glass material and 18px radius. -->
            <Border x:Name="PromptCapsule" Style="{StaticResource GlassCapsule}" CornerRadius="18" Padding="14,8">
                <FlyoutBase.AttachedFlyout>
                    <Flyout x:Name="ParamsFlyout" Placement="Top" Opening="ParamsFlyout_Opening" Closed="ParamsFlyout_Closed">
                        <ScrollViewer MaxHeight="460" Width="340">
                            <StackPanel x:Name="ParamsPanel" Spacing="4" Padding="0,0,12,0" />
                        </ScrollViewer>
                    </Flyout>
                </FlyoutBase.AttachedFlyout>
                <TextBox x:Name="PromptBox" AutomationProperties.Name="提示词" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="42" MaxHeight="160" Padding="0,2"
                         FontSize="13" Background="Transparent" BorderThickness="0"
                         PlaceholderText="描述想要生成的内容，Enter 生成，Shift+Enter 换行" TextChanged="PromptBox_TextChanged" PreviewKeyDown="PromptBox_PreviewKeyDown"
                         TextCompositionStarted="PromptBox_CompositionStarted" TextCompositionEnded="PromptBox_CompositionEnded"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                    </TextBox.Resources>
                </TextBox>
            </Border>

            <!-- Row 4: every bottom control is a strict Height=36, CornerRadius=18, FontSize=13 pill. -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <board:WrapPanel x:Name="ControlsRow" HorizontalSpacing="6" VerticalSpacing="6" VerticalAlignment="Center">
                    <!-- Segmented output-mode pill (replaces tall SelectorBar so height matches 36 DIP exactly). -->
                    <Border x:Name="ModeCapsule" Style="{StaticResource GlassCapsule}" Height="36" CornerRadius="18" Padding="2">
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button x:Name="ModeImageButton" Tag="Image" Style="{StaticResource ToolbarButton}" Height="30" MinHeight="0" Padding="10,0" CornerRadius="15" Click="ModeButton_Click" AutomationProperties.Name="生成图片">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xEB9F;" FontSize="13" Foreground="{ThemeResource KindImageBrush}" />
                                    <TextBlock Text="图片" FontSize="13" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ModeTextButton" Tag="Text" Style="{StaticResource ToolbarButton}" Height="30" MinHeight="0" Padding="10,0" CornerRadius="15" Click="ModeButton_Click" AutomationProperties.Name="生成文本">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE8D2;" FontSize="13" Foreground="{ThemeResource KindTextBrush}" />
                                    <TextBlock Text="文本" FontSize="13" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ModeAudioButton" Tag="Audio" Style="{StaticResource ToolbarButton}" Height="30" MinHeight="0" Padding="10,0" CornerRadius="15" Click="ModeButton_Click" AutomationProperties.Name="生成音频">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE8D6;" FontSize="13" Foreground="{ThemeResource KindAudioBrush}" />
                                    <TextBlock Text="音频" FontSize="13" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Border x:Name="ModelCapsule" Style="{StaticResource GlassCapsule}" Height="36" CornerRadius="18" Padding="2,0">
                        <ComboBox x:Name="ModelBox" Height="32" MinHeight="32" MinWidth="136" MaxWidth="188" FontSize="13" PlaceholderText="选择模型" AutomationProperties.Name="模型"
                                  Background="Transparent" BorderThickness="0" CornerRadius="16" VerticalAlignment="Center" SelectionChanged="ModelBox_SelectionChanged" />
                    </Border>
                    <Border x:Name="ParamsCapsule" Style="{StaticResource GlassCapsule}" Height="36" CornerRadius="18" Padding="2">
                        <Button x:Name="ParamsButton" Style="{StaticResource ToolbarButton}" Height="30" MinHeight="0" Padding="12,0" CornerRadius="15" AllowFocusOnInteraction="False"
                                ToolTipService.ToolTip="生成参数" AutomationProperties.Name="生成参数" Click="Params_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE9E9;" FontSize="13" />
                                <TextBlock x:Name="ParamsText" Text="参数" FontSize="13" MaxWidth="140" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                    </Border>
                    <Border x:Name="LibraryCapsule" Style="{StaticResource GlassCapsule}" Width="36" Height="36" CornerRadius="18" Padding="0">
                        <Button Style="{StaticResource ToolbarButton}" Width="34" Height="34" MinHeight="0" Padding="0" CornerRadius="17" AllowFocusOnInteraction="False"
                                ToolTipService.ToolTip="提示词库" AutomationProperties.Name="提示词库" Click="PromptLibrary_Click">
                            <FontIcon Glyph="&#xE734;" FontSize="13" />
                        </Button>
                    </Border>
                    <Border x:Name="InfoCapsule" Style="{StaticResource GlassCapsule}" Width="36" Height="36" CornerRadius="18" Padding="0" Visibility="Collapsed">
                        <Button x:Name="InfoButton" Style="{StaticResource ToolbarButton}" Width="34" Height="34" MinHeight="0" Padding="0" CornerRadius="17" AutomationProperties.Name="模型说明与识别文字">
                            <FontIcon Glyph="&#xE946;" FontSize="13" />
                        </Button>
                    </Border>
                    <Border x:Name="RecipeCapsule" Style="{StaticResource GlassCapsule}" Width="36" Height="36" CornerRadius="18" Padding="0">
                        <Button x:Name="RecipeButton" Style="{StaticResource ToolbarButton}" Width="34" Height="34" MinHeight="0" Padding="0" CornerRadius="17" AllowFocusOnInteraction="False"
                                ToolTipService.ToolTip="存为配方：把提示词、参考和设置存成一个配方节点" AutomationProperties.Name="存为配方" Click="SaveRecipe_Click">
                            <FontIcon Glyph="&#xE945;" FontSize="13" Foreground="{ThemeResource KindConfigBrush}" />
                        </Button>
                    </Border>
                </board:WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Border x:Name="EstimateCapsule" Style="{StaticResource GlassCapsule}" Height="36" CornerRadius="18" Padding="12,0" Visibility="Collapsed">
                        <TextBlock x:Name="EstimateText" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
                    </Border>
                    <Border x:Name="GenerateCapsule" Style="{StaticResource GlassCapsule}" Height="36" CornerRadius="18" Padding="2">
                        <Button x:Name="GenerateButton" Style="{StaticResource ToolbarButton}" Height="30" MinHeight="0" Padding="14,0" CornerRadius="15"
                                AllowFocusOnInteraction="False" Click="Generate_Click" AutomationProperties.Name="生成">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon x:Name="GenerateIcon" Glyph="&#xE768;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="GenerateText" Text="生成" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Button>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
