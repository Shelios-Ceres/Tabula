<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Tabula.App.Board.ComposerPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="Shell" Style="{StaticResource FloatingPanel}" Padding="14,10" Width="820">
        <!-- Parameters open above the composer, the way the prompt library does, so they never cover the prompt. -->
        <FlyoutBase.AttachedFlyout>
            <Flyout x:Name="ParamsFlyout" Placement="Top" Opening="ParamsFlyout_Opening" Closed="ParamsFlyout_Closed">
                <ScrollViewer MaxHeight="460" Width="340">
                    <StackPanel x:Name="ParamsPanel" Spacing="4" Padding="0,0,12,0" />
                </ScrollViewer>
            </Flyout>
        </FlyoutBase.AttachedFlyout>
        <!-- One box, like a chat composer: the references and where the result goes on top, the prompt, then output, model, parameters, cost and the button. -->
        <StackPanel Spacing="6">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" MaxWidth="470">
                    <StackPanel x:Name="RefChips" Orientation="Horizontal" Spacing="6" />
                </ScrollViewer>
                <Button x:Name="AddButton" Grid.Column="1" Style="{StaticResource ToolbarButton}" Padding="8,4" MinHeight="28" AutomationProperties.Name="添加参考" ToolTipService.ToolTip="从资料库或文件添加参考">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                        <TextBlock Text="添加" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout x:Name="AddMenu" Placement="Top" Opening="AddMenu_Opening" />
                    </Button.Flyout>
                </Button>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8AD;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="TargetText" AutomationProperties.Name="结果去向" Style="{StaticResource SecondaryCaption}" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                </StackPanel>
            </Grid>
            <TextBox x:Name="PromptBox" AutomationProperties.Name="提示词" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" MaxHeight="180" Padding="0,4"
                     Background="Transparent" BorderThickness="0"
                     PlaceholderText="描述想要生成的内容，Enter 生成，Shift+Enter 换行" TextChanged="PromptBox_TextChanged" PreviewKeyDown="PromptBox_PreviewKeyDown"
                     TextCompositionStarted="PromptBox_CompositionStarted" TextCompositionEnded="PromptBox_CompositionEnded"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <!-- The box is the composer itself: no field border or fill of its own, also while hovered and focused. -->
                <TextBox.Resources>
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                </TextBox.Resources>
            </TextBox>
            <!-- A missing model or API key, the marks left by 局部编辑 on the first picture, and a note the model returned for the selected node; each only while there is one. -->
            <StackPanel x:Name="InfoRow" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
                <StackPanel x:Name="HintRow" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="HintText" VerticalAlignment="Center" MaxWidth="330" TextTrimming="CharacterEllipsis" Style="{StaticResource SecondaryCaption}" />
                    <HyperlinkButton Content="去设置" Padding="6,2" Click="OpenSettings_Click" />
                </StackPanel>
                <StackPanel x:Name="MarksRow" Orientation="Horizontal" Spacing="2" Visibility="Collapsed">
                    <TextBlock x:Name="MarksText" VerticalAlignment="Center" MaxWidth="300" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Style="{StaticResource SecondaryCaption}" />
                    <HyperlinkButton Content="清除标注" Padding="6,2" Click="ClearMarks_Click" />
                </StackPanel>
            </StackPanel>

            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <SelectorBar x:Name="ModeBar" SelectionChanged="ModeBar_SelectionChanged" Padding="0" Margin="-4,-4,0,-4" VerticalAlignment="Center">
                    <SelectorBarItem Text="图片" Tag="Image"><SelectorBarItem.Icon><FontIcon Glyph="&#xEB9F;" Foreground="{ThemeResource KindImageBrush}" /></SelectorBarItem.Icon></SelectorBarItem>
                    <SelectorBarItem Text="文本" Tag="Text"><SelectorBarItem.Icon><FontIcon Glyph="&#xE8D2;" Foreground="{ThemeResource KindTextBrush}" /></SelectorBarItem.Icon></SelectorBarItem>
                    <SelectorBarItem Text="音频" Tag="Audio"><SelectorBarItem.Icon><FontIcon Glyph="&#xE8D6;" Foreground="{ThemeResource KindAudioBrush}" /></SelectorBarItem.Icon></SelectorBarItem>
                </SelectorBar>
                <ComboBox x:Name="ModelBox" Grid.Column="1" MinWidth="130" MaxWidth="160" PlaceholderText="选择模型" AutomationProperties.Name="模型" SelectionChanged="ModelBox_SelectionChanged" />
                <Button x:Name="ParamsButton" Grid.Column="2" Style="{StaticResource ActionButton}" Padding="10,7" AllowFocusOnInteraction="False"
                        ToolTipService.ToolTip="生成参数" AutomationProperties.Name="生成参数" Click="Params_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE9E9;" FontSize="13" />
                        <TextBlock x:Name="ParamsText" Text="参数" MaxWidth="130" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource ActionButton}" Padding="10,7" AllowFocusOnInteraction="False"
                        ToolTipService.ToolTip="提示词库" AutomationProperties.Name="提示词库" Click="PromptLibrary_Click">
                    <FontIcon Glyph="&#xE734;" FontSize="13" />
                </Button>
                <!-- Model notes and recognised text of the selected picture: in the tooltip, not in the way. -->
                <Button x:Name="InfoButton" Grid.Column="4" Style="{StaticResource ToolbarButton}" Padding="8,4" MinHeight="28" Visibility="Collapsed"
                        AutomationProperties.Name="模型说明与识别文字">
                    <FontIcon Glyph="&#xE946;" FontSize="14" />
                </Button>
                <!-- Expected cost of the next image run, updated as the model, parameters, prompt and references change; the whole text is in the tooltip. -->
                <TextBlock x:Name="EstimateText" Grid.Column="5" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="6,0" TextTrimming="CharacterEllipsis" MaxLines="1"
                           Style="{StaticResource SecondaryCaption}" />
                <Button x:Name="RecipeButton" Grid.Column="6" Style="{StaticResource ActionButton}" Padding="10,7" AllowFocusOnInteraction="False"
                        ToolTipService.ToolTip="存为配方：把提示词、参考和设置存成一个配方节点" AutomationProperties.Name="存为配方" Click="SaveRecipe_Click">
                    <FontIcon Glyph="&#xE945;" FontSize="13" Foreground="{ThemeResource KindConfigBrush}" />
                </Button>
                <Button x:Name="GenerateButton" Grid.Column="7" Style="{StaticResource AccentActionButton}" AllowFocusOnInteraction="False" Click="Generate_Click"
                        AutomationProperties.Name="生成">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:Name="GenerateIcon" Glyph="&#xE768;" FontSize="13" />
                        <TextBlock x:Name="GenerateText" Text="生成" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
