<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Tabula.App.Board.AgentPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="Shell" Style="{StaticResource FloatingPanel}" Padding="12,10,12,10">
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: title, agent selector, new chat, close -->
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="2,0,4,0">
                    <FontIcon Glyph="&#xE99A;" FontSize="15" />
                    <TextBlock Text="助手" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <ComboBox x:Name="AgentPicker" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="AgentPicker_SelectionChanged" AutomationProperties.Name="选择 Agent" />
                <Button x:Name="NewChatButton" Grid.Column="2" Style="{StaticResource ToolbarButton}" Padding="9,7" Click="NewChat_Click" ToolTipService.ToolTip="新对话" AutomationProperties.Name="新对话">
                    <FontIcon Glyph="&#xE710;" FontSize="13" />
                </Button>
                <Button x:Name="CloseButton" Grid.Column="3" Style="{StaticResource ToolbarButton}" Padding="9,7" Click="Close_Click" ToolTipService.ToolTip="关闭助手抽屉" AutomationProperties.Name="关闭助手">
                    <FontIcon Glyph="&#xE711;" FontSize="13" />
                </Button>
            </Grid>

            <!-- Transcript list -->
            <ScrollViewer x:Name="Scroller" Grid.Row="1" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0" Margin="0,0,-6,0" ViewChanged="Scroller_ViewChanged">
                <StackPanel x:Name="Messages" Spacing="10" Padding="0,4" />
            </ScrollViewer>
            <Button x:Name="LatestButton" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"
                    Style="{StaticResource ActionButton}" Visibility="Collapsed" Content="回到最新" Click="Latest_Click" />

            <!-- Empty state with starter prompts -->
            <StackPanel x:Name="EmptyState" Grid.Row="1" Spacing="10" VerticalAlignment="Center" Margin="10,0">
                <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="在下方指令栏的「助手」模式里说话。助手能读取画布、增删改节点、连线和发起生成，每次修改只记一步撤销。" />
                <StackPanel x:Name="Suggestions" Spacing="6" />
            </StackPanel>

            <!-- Footer: external agent connection status -->
            <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeBrush}" Padding="2,8,2,0">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE839;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="FooterStatus" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
