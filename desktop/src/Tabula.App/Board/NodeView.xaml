<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Tabula.App.Board.NodeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- A collapsed batch stack shows two cards peeking out behind the lead card. -->
        <Border x:Name="DeckBack2" CornerRadius="14" BorderThickness="1" Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource CardStrokeBrush}" Visibility="Collapsed" IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform X="16" Y="16" />
            </Border.RenderTransform>
        </Border>
        <Border x:Name="DeckBack1" CornerRadius="14" BorderThickness="1" Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource CardStrokeBrush}" Visibility="Collapsed" IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform X="8" Y="8" />
            </Border.RenderTransform>
        </Border>
        <!-- Group tint in the group colour; stays hit-testable so groups can be clicked and dragged. -->
        <Border x:Name="GroupFill" CornerRadius="18" Background="{ThemeResource KindGroupBrush}" Opacity="0.08" Visibility="Collapsed" />
        <!-- Liquid glass experiment: rounder cards (14) to sit with the glass surfaces. -->
        <Border x:Name="Card" CornerRadius="14" BorderThickness="1"
                Background="{ThemeResource CardBrush}"
                BorderBrush="{ThemeResource CardStrokeBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid x:Name="Header" Padding="12,10,10,6" ColumnSpacing="8" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Colourful kind tile, like the icons in Windows 11 Settings. -->
                    <Border x:Name="KindTile" Width="20" Height="20" CornerRadius="7">
                        <FontIcon x:Name="KindIcon" FontSize="11" Foreground="White" />
                    </Border>
                    <TextBlock x:Name="TitleText" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Border x:Name="StatusChip" Grid.Column="2" RenderTransformOrigin="1,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ProgressRing x:Name="Busy" Width="14" Height="14" IsActive="False" Visibility="Collapsed" />
                            <FontIcon x:Name="ErrorIcon" Glyph="&#xE783;" FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid x:Name="Body" Grid.Row="1" CornerRadius="0,0,13,13">
                    <StackPanel x:Name="PlaceholderPanel" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <FontIcon x:Name="PlaceholderIcon" FontSize="28" />
                        <TextBlock x:Name="PlaceholderText" TextAlignment="Center" Style="{StaticResource SecondaryCaption}" />
                    </StackPanel>
                    <TextBlock x:Name="ConfigMeta" Visibility="Collapsed" Margin="12,0,12,10" VerticalAlignment="Bottom" TextWrapping="Wrap" Style="{StaticResource SecondaryCaption}" />
                </Grid>
                <!-- Empty cards explain their state in the middle: generating, failed, stopped or a video still running. -->
                <StackPanel x:Name="StatusView" Grid.RowSpan="2" Spacing="6" Margin="16" MaxWidth="260" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <ProgressRing x:Name="BigBusy" Width="28" Height="28" IsActive="False" />
                    <FontIcon x:Name="FailIcon" Glyph="&#xE783;" FontSize="22" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <FontIcon x:Name="InfoIcon" FontSize="22" Style="{StaticResource SecondaryIcon}" />
                    <TextBlock x:Name="StatusTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="StatusDetail" Style="{StaticResource SecondaryCaption}" TextAlignment="Center" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                    <Button x:Name="RetryButton" Content="重试" Style="{StaticResource ActionButton}" HorizontalAlignment="Center" Margin="0,4,0,0" Visibility="Collapsed" Click="Retry_Click"
                            ToolTipService.ToolTip="按生成它的节点当前的提示词和输入，重新生成到这里" AutomationProperties.Name="重试" />
                </StackPanel>
            </Grid>
        </Border>
        <!-- Selection sits outside the card so the content never shifts; SetZoom keeps it 2 px on screen. Shown by fading its opacity. -->
        <Border x:Name="SelectionRing" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" IsHitTestVisible="False" Opacity="0" />
        <!-- Media nodes keep the picture clean: their title floats above the card on hover / selection. -->
        <TextBlock x:Name="FloatingTitle" VerticalAlignment="Top" Margin="6,-24,0,0" Height="18" Opacity="0" IsHitTestVisible="False"
                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextTrimming="CharacterEllipsis" RenderTransformOrigin="0,1" />
        <!-- Marks the reference node when matching sizes in a multi-selection. -->
        <Border x:Name="AnchorChip" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-28,0,0" Height="20" Padding="8,2" CornerRadius="10"
                Background="{ThemeResource AccentFillColorDefaultBrush}" RenderTransformOrigin="1,1" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock Text="基准" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        </Border>
        <!-- 参考 N: the node is a reference of the composer's next generation (its number on the chip there). Inside the card's top-right corner, clear of 基准. -->
        <Border x:Name="RefChip" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,8,8,0" Height="20" Padding="8,2" CornerRadius="10"
                Background="{ThemeResource AccentFillColorDefaultBrush}" RenderTransformOrigin="1,0" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="RefText" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        </Border>
        <!-- Batch stacks: the count on a collapsed stack (click the card to open it), 收起 on the lead of an opened one. -->
        <Border x:Name="StackBadge" Style="{StaticResource GlassChip}" Padding="0" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8,8,0,0"
                RenderTransformOrigin="0,0" Visibility="Collapsed">
            <Button x:Name="StackButton" Style="{StaticResource ToolbarButton}" Padding="6,4" MinHeight="0" AutomationProperties.Name="展开或收起批次" AutomationProperties.AutomationId="ToggleStack">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon x:Name="StackIcon" FontSize="12" />
                    <TextBlock x:Name="StackText" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </Border>
        <Rectangle x:Name="GroupOutline" RadiusX="18" RadiusY="18" StrokeThickness="1.5" StrokeDashArray="4,3" Visibility="Collapsed" IsHitTestVisible="False"
                   Stroke="{ThemeResource KindGroupBrush}" />
        <Ellipse x:Name="TargetHandle" Tag="target" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-7,0,0,0"
                 Fill="{ThemeResource SolidBackgroundFillColorBaseBrush}" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="2"
                 RenderTransformOrigin="0.5,0.5" Opacity="0" ToolTipService.ToolTip="拖出连线：连到上游节点" />
        <Ellipse x:Name="SourceHandle" Tag="source" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-7,0"
                 Fill="{ThemeResource SolidBackgroundFillColorBaseBrush}" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="2"
                 RenderTransformOrigin="0.5,0.5" Opacity="0" ToolTipService.ToolTip="拖出连线：作为下游节点的输入" />
        <Grid x:Name="ResizeGrip" Tag="resize" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-9,-9"
              Background="Transparent" RenderTransformOrigin="0.5,0.5" Opacity="0" ToolTipService.ToolTip="拖动调整大小（图片、视频按住 Shift 可不锁定比例）">
            <Ellipse Width="10" Height="10" Fill="{ThemeResource SolidBackgroundFillColorBaseBrush}" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="2" IsHitTestVisible="False" />
        </Grid>
    </Grid>
</UserControl>
