<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="InfiniteCanvas.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Windows 11 Fluent: the system accent colour, 4 px controls and 8 px overlays (the WinUI defaults), subtle toolbar buttons
                and a translucent canvas over the window's desktop acrylic. Colour comes from a per-kind palette (Kind*Brush),
                defined in every theme dictionary; Win2D drawing and code-built elements read them through Palette.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <!-- Translucent so the window's desktop acrylic shows through the whole canvas. -->
                    <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#99F3F4F8" />
                    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardStrokeBrush" Color="#17000000" />
                    <!-- In-app acrylic: clear for small toolbars, denser for panels with more text. -->
                    <AcrylicBrush x:Key="GlassBrush" TintColor="#FCFCFC" TintOpacity="0.1" TintLuminosityOpacity="0.6" FallbackColor="#F2F9F9F9" />
                    <AcrylicBrush x:Key="GlassThickBrush" TintColor="#FCFCFC" TintOpacity="0.3" TintLuminosityOpacity="0.78" FallbackColor="#F9F9F9" />
                    <SolidColorBrush x:Key="GlassStrokeBrush" Color="#1F000000" />

                    <SolidColorBrush x:Key="KindImageBrush" Color="#0F6CBD" />
                    <SolidColorBrush x:Key="KindVideoBrush" Color="#7A4CC9" />
                    <SolidColorBrush x:Key="KindAudioBrush" Color="#D9480F" />
                    <SolidColorBrush x:Key="KindTextBrush" Color="#0E8A3B" />
                    <SolidColorBrush x:Key="KindConfigBrush" Color="#C0287F" />
                    <SolidColorBrush x:Key="KindGroupBrush" Color="#00838F" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#991C1C20" />
                    <SolidColorBrush x:Key="CardBrush" Color="#2B2B2F" />
                    <SolidColorBrush x:Key="CardStrokeBrush" Color="#1FFFFFFF" />
                    <AcrylicBrush x:Key="GlassBrush" TintColor="#2C2C2C" TintOpacity="0.15" TintLuminosityOpacity="0.7" FallbackColor="#F22C2C2C" />
                    <AcrylicBrush x:Key="GlassThickBrush" TintColor="#2C2C2C" TintOpacity="0.4" TintLuminosityOpacity="0.85" FallbackColor="#2C2C2C" />
                    <SolidColorBrush x:Key="GlassStrokeBrush" Color="#2EFFFFFF" />

                    <SolidColorBrush x:Key="KindImageBrush" Color="#2E8BE8" />
                    <SolidColorBrush x:Key="KindVideoBrush" Color="#9466E0" />
                    <SolidColorBrush x:Key="KindAudioBrush" Color="#F06A1F" />
                    <SolidColorBrush x:Key="KindTextBrush" Color="#23A559" />
                    <SolidColorBrush x:Key="KindConfigBrush" Color="#D9449A" />
                    <SolidColorBrush x:Key="KindGroupBrush" Color="#1AA3AE" />
                </ResourceDictionary>
                <!-- Contrast themes: solid system colours, no acrylic, system accent untouched. Every token added to Light/Dark must be added here too. -->
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CardBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CardStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="GlassBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="GlassThickBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="GlassStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="KindImageBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="KindVideoBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="KindAudioBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="KindTextBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="KindConfigBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="KindGroupBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Floating toolbars on the canvas: clear acrylic, 8 px corners like Windows 11 command bars. -->
            <Style x:Key="GlassCapsule" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource GlassBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource GlassStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="4" />
            </Style>
            <!-- Panels with more text (prompt panel, library, assistant) use a denser acrylic for legibility. -->
            <Style x:Key="FloatingPanel" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource GlassThickBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource GlassStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
            </Style>
            <!-- Content sections on pages (settings, empty states): the Windows 11 card surface over the window acrylic. -->
            <Style x:Key="SectionCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="20" />
            </Style>
            <!-- Windows 11 subtle button: no fill until hovered. Clicking never takes focus from the canvas; Tab still reaches it. -->
            <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="AllowFocusOnInteraction" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter x:Name="ContentPresenter" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}"
                                              CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"
                                              Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              AutomationProperties.AccessibilityView="Raw">
                                <ContentPresenter.BackgroundTransition>
                                    <BrushTransition Duration="0:0:0.083" />
                                </ContentPresenter.BackgroundTransition>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </ContentPresenter>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Same as ToolbarButton; checked keeps a subtle fill with accent content, like selected tools in Windows 11 apps. -->
            <Style x:Key="ToolbarToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="AllowFocusOnInteraction" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <ContentPresenter x:Name="ContentPresenter" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}"
                                              CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"
                                              Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              AutomationProperties.AccessibilityView="Raw">
                                <ContentPresenter.BackgroundTransition>
                                    <BrushTransition Duration="0:0:0.083" />
                                </ContentPresenter.BackgroundTransition>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AccentTextFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedDisabled">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </ContentPresenter>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Vertical divider between groups inside a toolbar. -->
            <Style x:Key="ToolbarDivider" TargetType="Rectangle">
                <Setter Property="Width" Value="1" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Margin" Value="4,0" />
                <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>
            <!-- Styles for elements built in code: ThemeResource in a setter follows theme switches, a brush read from Resources does not. -->
            <Style x:Key="SecondaryCaption" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="SecondaryIcon" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <!-- Small acrylic chip floating on media (status chips, video badges, stack counts). -->
            <Style x:Key="GlassChip" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource GlassBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource GlassStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="Padding" Value="6,4" />
            </Style>
            <!-- Standard Windows 11 buttons with a little more room for an icon and a label. -->
            <Style x:Key="AccentActionButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="MinHeight" Value="32" />
            </Style>
            <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="MinHeight" Value="32" />
            </Style>
            <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
