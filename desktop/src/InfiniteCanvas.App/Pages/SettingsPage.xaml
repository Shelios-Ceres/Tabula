<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InfiniteCanvas.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:InfiniteCanvas.App.Pages"
    Background="Transparent">
    <Grid Padding="24,8,24,24" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Style="{StaticResource ToolbarButton}" Padding="10,7" Click="Back_Click" ToolTipService.ToolTip="返回" AutomationProperties.Name="返回">
                    <FontIcon Glyph="&#xE76B;" FontSize="15" />
                </Button>
                <TextBlock Text="设置" Style="{StaticResource PageTitle}" />
            </StackPanel>
            <Grid Grid.Row="1">
                <TextBlock Text="服务商" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <Button Style="{StaticResource ToolbarButton}" Padding="9,6" HorizontalAlignment="Right" ToolTipService.ToolTip="添加服务商" AutomationProperties.Name="添加服务商">
                    <FontIcon Glyph="&#xE710;" FontSize="13" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="VendorMenu" Placement="BottomEdgeAlignedRight" />
                    </Button.Flyout>
                </Button>
            </Grid>
            <ListView x:Name="ChannelList" Grid.Row="2" SelectionChanged="ChannelList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="pages:ChannelRow">
                        <StackPanel Padding="0,6" Spacing="1">
                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE7BA;" FontSize="11" Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind MissingKey}" />
                                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource SecondaryCaption}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <ScrollViewer x:Name="ContentScroller" Grid.Column="1">
            <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left" Padding="0,8,16,24">
                <Border x:Name="NoChannelCard" Style="{StaticResource SectionCard}" Padding="32" Visibility="Collapsed">
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE8D7;" FontSize="32" Foreground="{ThemeResource KindVideoBrush}" />
                        <TextBlock Text="还没有服务商" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                        <TextBlock Text="添加 OpenAI、Google Gemini、火山方舟、xAI 或千问，填入 API Key 后即可在画布里生成" Style="{StaticResource SecondaryCaption}"
                                   TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                        <Button Style="{StaticResource AccentActionButton}" Content="添加服务商" HorizontalAlignment="Center" Click="AddChannelButton_Click" />
                    </StackPanel>
                </Border>
                <Border x:Name="EditorCard" Style="{StaticResource SectionCard}">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="28" Height="28" CornerRadius="6" Background="{ThemeResource KindVideoBrush}"><FontIcon Glyph="&#xE8D7;" FontSize="14" Foreground="White" /></Border>
                            <TextBlock x:Name="EditorTitle" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BaseUrlBox" Header="接口地址（只填域名，版本路径自动拼接）" TextChanged="Field_Changed" />
                            <ComboBox x:Name="VersionBox" Grid.Column="1" Header="接口版本" Width="120" SelectionChanged="Field_Changed">
                                <x:String>v1beta</x:String>
                                <x:String>v1</x:String>
                            </ComboBox>
                        </Grid>
                        <PasswordBox x:Name="KeyBox" Header="API Key" PlaceholderText="粘贴服务商控制台里的 API Key" PasswordChanged="Field_Changed" />
                        <InfoBar x:Name="KeyWarning" Severity="Warning" IsClosable="False" Title="还没有填写 API Key" Message="填写后才能用这家服务商生成；Key 用 Windows 数据保护（DPAPI）加密保存在本机。" />
                        <TextBlock x:Name="ApiHint" Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap" />

                        <Grid>
                            <TextBlock Text="模型" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                <Button x:Name="FetchButton" Style="{StaticResource ToolbarButton}" Click="FetchModels_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE895;" FontSize="13" />
                                        <TextBlock x:Name="FetchText" Text="拉取模型列表" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolbarButton}" Click="Recommended_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE734;" FontSize="13" />
                                        <TextBlock Text="添加推荐模型" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="ModelRows" Spacing="6" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NewModelBox" PlaceholderText="手动输入模型名称，例如 gpt-image-2" KeyDown="NewModelBox_KeyDown" />
                            <TextBox x:Name="NewEndpointBox" Grid.Column="1" Width="220" PlaceholderText="推理接入点 ep-（可选）" KeyDown="NewModelBox_KeyDown"
                                     AutomationProperties.Name="推理接入点" Visibility="Collapsed" />
                            <Button Grid.Column="2" Style="{StaticResource ActionButton}" Content="添加" Click="AddModel_Click" />
                        </Grid>
                        <Button Click="DeleteChannel_Click" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Style="{StaticResource ToolbarButton}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                <TextBlock Text="删除此服务商" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="28" Height="28" CornerRadius="6" Background="{ThemeResource KindImageBrush}"><FontIcon Glyph="&#xE8B9;" FontSize="14" Foreground="White" /></Border>
                            <TextBlock Text="默认模型" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <ComboBox x:Name="ImageDefault" Header="图片" HorizontalAlignment="Stretch" SelectionChanged="Default_Changed" Tag="Image" />
                            <ComboBox x:Name="TextDefault" Grid.Column="1" Header="文本" HorizontalAlignment="Stretch" SelectionChanged="Default_Changed" Tag="Text" />
                            <ComboBox x:Name="AudioDefault" Grid.Row="1" Header="音频" HorizontalAlignment="Stretch" SelectionChanged="Default_Changed" Tag="Audio" />
                        </Grid>
                        <TextBox x:Name="SystemPromptBox" Header="文本模型系统提示词（可选）" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" TextChanged="SystemPrompt_Changed" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="28" Height="28" CornerRadius="6" Background="{ThemeResource KindConfigBrush}"><FontIcon Glyph="&#xE99A;" FontSize="14" Foreground="White" /></Border>
                            <TextBlock Text="Agent 助手" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap"
                                   Text="画布右侧的「助手」会通过 ACP（Agent Client Protocol）启动本机的 Agent，并把画布工具交给它使用。需要先装好对应的 Agent 并在终端里登录过；启动命令可以改成本机的实际路径。" />
                        <StackPanel x:Name="AgentList" Spacing="10" />
                        <ToggleSwitch x:Name="ExternalAgentsSwitch" Header="允许外部 Agent 连接" OnContent="开启" OffContent="关闭" Toggled="ExternalAgents_Toggled" />
                        <TextBlock Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   Text="开启后，客户端外的 Agent（如 Claude Code、终端里的 Kimi / Grok）可以操作当前打开的画布：把下面的命令登记为它们的 MCP 服务器即可。只有你自己 Windows 账户下的程序能连接，不开放网络端口。" />
                        <TextBox x:Name="BridgeCommand" IsReadOnly="True" FontFamily="Consolas" AutomationProperties.Name="外部 Agent 的 MCP 启动命令" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="28" Height="28" CornerRadius="6" Background="{ThemeResource KindTextBrush}"><FontIcon Glyph="&#xE72E;" FontSize="14" Foreground="White" /></Border>
                            <TextBlock Text="数据与安全" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="画布、图片、视频和设置都只保存在本机，不会上传到任何服务器。API Key 使用 Windows 数据保护（DPAPI）按当前用户加密保存；生成请求由客户端直接发往各服务商，走系统代理设置。" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="DataPath" VerticalAlignment="Center" IsTextSelectionEnabled="True" Style="{StaticResource CaptionTextBlockStyle}" />
                            <Button Style="{StaticResource ActionButton}" Content="打开文件夹" Click="OpenData_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Image Source="ms-appx:///Assets/Logo.png" Width="48" Height="48" VerticalAlignment="Center" />
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="ProductText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="VersionText" Style="{StaticResource SecondaryCaption}" IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
