<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InfiniteCanvas.App.Pages.CanvasPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:board="using:InfiniteCanvas.App.Board"
    Background="Transparent"
    SizeChanged="Page_SizeChanged">
    <Grid>
        <board:CanvasView x:Name="Board" />

        <!-- Top-left: back, title, save state -->
        <board:GlassScale x:Name="TitleHost" Margin="16,12,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Border x:Name="TitleCapsule" Style="{StaticResource GlassCapsule}">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Style="{StaticResource ToolbarButton}" Padding="10,7" Click="Back_Click" ToolTipService.ToolTip="返回画布列表" AutomationProperties.Name="返回画布列表">
                    <FontIcon Glyph="&#xE76B;" FontSize="15" />
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Click="Rename_Click" ToolTipService.ToolTip="重命名画布" AutomationProperties.Name="重命名画布">
                    <TextBlock x:Name="TitleText" MaxWidth="200" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Click="Save_Click" ToolTipService.ToolTip="立即保存；保存失败时点击重试" AutomationProperties.Name="保存画布">
                    <TextBlock x:Name="SaveState" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>
                <Rectangle Style="{StaticResource ToolbarDivider}" />
                <ToggleButton x:Name="LibraryToggle" Style="{StaticResource ToolbarToggleButton}" Padding="10,7" Click="LibraryToggle_Click" ToolTipService.ToolTip="资料库" AutomationProperties.Name="资料库">
                    <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE8F1;" FontSize="15" /><TextBlock x:Name="LibraryLabel" Text="资料库" /></StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="AgentToggle" Style="{StaticResource ToolbarToggleButton}" Padding="10,7" Click="AgentToggle_Click" ToolTipService.ToolTip="助手：让本机的 Agent 操作画布" AutomationProperties.Name="助手">
                    <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE99A;" FontSize="15" /><TextBlock x:Name="AgentLabel" Text="助手" /></StackPanel>
                </ToggleButton>
                <Button x:Name="QuotaButton" Style="{StaticResource ToolbarButton}" Padding="10,7" ToolTipService.ToolTip="额度：各服务商的余额与本机用量" AutomationProperties.Name="额度">
                    <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE8C7;" FontSize="15" /><TextBlock x:Name="QuotaLabel" Text="额度" /></StackPanel>
                </Button>
            </StackPanel>
        </Border>
        </board:GlassScale>

        <!-- Left: shared media library -->
        <board:LibraryPanel x:Name="Library" Width="300" Margin="16,72,0,16" HorizontalAlignment="Left" VerticalAlignment="Stretch" Visibility="Collapsed" />

        <!-- Bottom-left: overview map, beside the library when it is open -->
        <board:MiniMap x:Name="Map" Margin="16,0,0,16" HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="Collapsed" />

        <!-- Right: local agent assistant, above the zoom capsule -->
        <board:AgentPanel x:Name="Agent" Width="380" Margin="0,72,16,72" HorizontalAlignment="Right" VerticalAlignment="Stretch" Visibility="Collapsed" />

        <!-- Top-center: create nodes, import, undo/redo -->
        <board:GlassScale x:Name="ToolHost" Margin="0,12,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
        <Border x:Name="ToolCapsule" Style="{StaticResource GlassCapsule}">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Style="{StaticResource ToolbarButton}" Click="AddText_Click" ToolTipService.ToolTip="文本节点" AutomationProperties.Name="文本节点">
                    <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE8D2;" FontSize="15" Foreground="{ThemeResource KindTextBrush}" /><TextBlock x:Name="TextLabel" Text="文本" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Click="AddImage_Click" ToolTipService.ToolTip="图片节点" AutomationProperties.Name="图片节点">
                    <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xEB9F;" FontSize="15" Foreground="{ThemeResource KindImageBrush}" /><TextBlock x:Name="ImageLabel" Text="图片" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Click="AddVideo_Click" ToolTipService.ToolTip="视频节点" AutomationProperties.Name="视频节点">
                    <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE714;" FontSize="15" Foreground="{ThemeResource KindVideoBrush}" /><TextBlock x:Name="VideoLabel" Text="视频" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Click="AddAudio_Click" ToolTipService.ToolTip="音频节点" AutomationProperties.Name="音频节点">
                    <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE8D6;" FontSize="15" Foreground="{ThemeResource KindAudioBrush}" /><TextBlock x:Name="AudioLabel" Text="音频" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Click="AddConfig_Click" ToolTipService.ToolTip="生成配置：连接多个输入，统一生成" AutomationProperties.Name="生成配置：连接多个输入，统一生成">
                    <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE945;" FontSize="15" Foreground="{ThemeResource KindConfigBrush}" /><TextBlock x:Name="ConfigLabel" Text="生成配置" /></StackPanel>
                </Button>
                <Rectangle Style="{StaticResource ToolbarDivider}" />
                <Button Style="{StaticResource ToolbarButton}" Padding="10,7" Click="Import_Click" ToolTipService.ToolTip="导入图片、视频或音频" AutomationProperties.Name="导入图片、视频或音频">
                    <FontIcon Glyph="&#xE8E5;" FontSize="15" />
                </Button>
                <Button x:Name="UndoButton" Style="{StaticResource ToolbarButton}" Padding="10,7" Click="Undo_Click" ToolTipService.ToolTip="撤销 (Ctrl+Z)" AutomationProperties.Name="撤销 (Ctrl+Z)">
                    <FontIcon Glyph="&#xE7A7;" FontSize="15" />
                </Button>
                <Button x:Name="RedoButton" Style="{StaticResource ToolbarButton}" Padding="10,7" Click="Redo_Click" ToolTipService.ToolTip="重做 (Ctrl+Shift+Z)" AutomationProperties.Name="重做 (Ctrl+Shift+Z)">
                    <FontIcon Glyph="&#xE7A6;" FontSize="15" />
                </Button>
            </StackPanel>
        </Border>
        </board:GlassScale>

        <!-- Bottom-right: zoom -->
        <board:GlassScale x:Name="ZoomHost" Margin="0,0,16,16" HorizontalAlignment="Right" VerticalAlignment="Bottom">
        <Border x:Name="ZoomCapsule" Style="{StaticResource GlassCapsule}">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Style="{StaticResource ToolbarButton}" Padding="10,7" Click="ZoomOut_Click" ToolTipService.ToolTip="缩小" AutomationProperties.Name="缩小">
                    <FontIcon Glyph="&#xE738;" FontSize="15" />
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Click="ZoomReset_Click" ToolTipService.ToolTip="恢复 100% (Ctrl+0)" AutomationProperties.Name="恢复 100% (Ctrl+0)" MinWidth="68">
                    <TextBlock x:Name="ZoomText" Text="100%" FontWeight="SemiBold" />
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Padding="10,7" Click="ZoomIn_Click" ToolTipService.ToolTip="放大" AutomationProperties.Name="放大">
                    <FontIcon Glyph="&#xE710;" FontSize="15" />
                </Button>
                <Rectangle Style="{StaticResource ToolbarDivider}" />
                <Button Style="{StaticResource ToolbarButton}" Padding="10,7" Click="Fit_Click" ToolTipService.ToolTip="显示全部内容 (Ctrl+1)" AutomationProperties.Name="显示全部内容 (Ctrl+1)">
                    <FontIcon Glyph="&#xE9A6;" FontSize="15" />
                </Button>
                <ToggleButton x:Name="GlassToggle" Style="{StaticResource ToolbarToggleButton}" Padding="10,7" Click="GlassToggle_Click" ToolTipService.ToolTip="液态玻璃设置 (Ctrl+Shift+L)" AutomationProperties.Name="液态玻璃设置 (Ctrl+Shift+L)">
                    <FontIcon Glyph="&#xE771;" FontSize="15" />
                </ToggleButton>
                <ToggleButton x:Name="MiniMapToggle" Style="{StaticResource ToolbarToggleButton}" Padding="10,7" Click="MiniMapToggle_Click" ToolTipService.ToolTip="小地图" AutomationProperties.Name="小地图">
                    <FontIcon Glyph="&#xE826;" FontSize="15" />
                </ToggleButton>
                <Button Style="{StaticResource ToolbarButton}" Padding="10,7" ToolTipService.ToolTip="操作说明" AutomationProperties.Name="操作说明">
                    <FontIcon Glyph="&#xE9CE;" FontSize="15" />
                    <Button.Flyout>
                        <Flyout Placement="TopEdgeAlignedRight">
                            <Grid ColumnSpacing="24" RowSpacing="8" Width="340">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="移动画布" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="空白处拖动 · 按住空格或中键拖动 · 触控板双指滑动" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="1" Text="缩放" FontWeight="SemiBold" /><TextBlock Grid.Row="1" Grid.Column="1" Text="滚轮 · 触控板双指捏合 · Ctrl+= / Ctrl+-" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="2" Text="选择" FontWeight="SemiBold" /><TextBlock Grid.Row="2" Grid.Column="1" Text="Ctrl+A 全选 · Esc 取消选择" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="3" Text="框选" FontWeight="SemiBold" /><TextBlock Grid.Row="3" Grid.Column="1" Text="按住 Shift 或 Ctrl 在空白处拖动" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="4" Text="连线" FontWeight="SemiBold" /><TextBlock Grid.Row="4" Grid.Column="1" Text="拖动节点两侧的圆点" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="5" Text="新建" FontWeight="SemiBold" /><TextBlock Grid.Row="5" Grid.Column="1" Text="双击空白处 · 从资料库拖入" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="6" Text="编辑" FontWeight="SemiBold" /><TextBlock Grid.Row="6" Grid.Column="1" Text="Enter 进入提示词或文本 · Esc 回到画布 · F2 重命名" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="7" Text="粘贴 / 导入" FontWeight="SemiBold" /><TextBlock Grid.Row="7" Grid.Column="1" Text="Ctrl+V 粘贴图片、文字或文件 · 把文件拖进窗口" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="8" Text="撤销 / 重做" FontWeight="SemiBold" /><TextBlock Grid.Row="8" Grid.Column="1" Text="Ctrl+Z · Ctrl+Shift+Z" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="9" Text="复制 / 删除" FontWeight="SemiBold" /><TextBlock Grid.Row="9" Grid.Column="1" Text="Ctrl+C 复制图片或文字到剪贴板 · Ctrl+D 复制节点 · Delete" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="10" Text="编组" FontWeight="SemiBold" /><TextBlock Grid.Row="10" Grid.Column="1" Text="Ctrl+G · 取消 Ctrl+Shift+G" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="11" Text="统一尺寸" FontWeight="SemiBold" /><TextBlock Grid.Row="11" Grid.Column="1" Text="多选后用上方工具条：同宽 / 同高 / 同宽高，以第一个点选的节点为基准" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="12" Text="微调位置" FontWeight="SemiBold" /><TextBlock Grid.Row="12" Grid.Column="1" Text="方向键移动 1 像素 · 按住 Shift 移动 10 像素" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="13" Text="查看大图" FontWeight="SemiBold" /><TextBlock Grid.Row="13" Grid.Column="1" Text="双击图片 · Ctrl+滚轮缩放 · 选中两张图片后按 C 对比 · Esc 关闭" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="14" Text="一批结果" FontWeight="SemiBold" /><TextBlock Grid.Row="14" Grid.Column="1" Text="批量生成的结果叠成一摞，点击展开，点「收起」收回，被选中的那张做封面" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="15" Text="更多" FontWeight="SemiBold" /><TextBlock Grid.Row="15" Grid.Column="1" Text="在节点或空白处点右键" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Border>
        </board:GlassScale>

        <!-- Liquid glass experiment: tuning panel (Ctrl+Shift+L) -->
        <board:GlassTuningPanel x:Name="GlassPanel" Width="460" Margin="0,72,16,72" HorizontalAlignment="Right" VerticalAlignment="Stretch" Visibility="Collapsed" />
    </Grid>
</Page>
