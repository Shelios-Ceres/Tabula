<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="InfiniteCanvas.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="无限画布">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Canvas pages paint the title bar with the canvas colour so both read as one surface. -->
        <Border x:Name="TitleBackdrop" Background="{ThemeResource CanvasBackgroundBrush}" Visibility="Collapsed" />
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/Logo.png" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock x:Name="TitleText" Grid.Column="1" Text="无限画布" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="NoWrap" VerticalAlignment="Center" />
        </Grid>
        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
