<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InfiniteCanvas.App.Board.AgentPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="Shell" Style="{StaticResource FloatingPanel}" Padding="12,10,12,12">
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="AgentPicker" HorizontalAlignment="Stretch" SelectionChanged="AgentPicker_SelectionChanged" AutomationProperties.Name="选择 Agent" />
                <Button Grid.Column="1" Style="{StaticResource ToolbarButton}" Padding="9,7" Click="NewChat_Click" ToolTipService.ToolTip="新对话" AutomationProperties.Name="新对话">
                    <FontIcon Glyph="&#xE710;" FontSize="13" />
                </Button>
            </Grid>
            <ScrollViewer x:Name="Scroller" Grid.Row="1" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0" Margin="0,0,-6,0">
                <StackPanel x:Name="Messages" Spacing="10" Padding="0,4" />
            </ScrollViewer>
            <TextBlock x:Name="EmptyText" Grid.Row="1" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="20,0"
                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="让本机的 Agent 直接操作这张画布：读节点、加节点、连线、出图。&#x0a;例如：「把选中的图做成 3 个不同风格的版本」。" />
            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InputBox" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="160" PlaceholderText="想让 Agent 做什么？Enter 发送，Shift+Enter 换行"
                         PreviewKeyDown="InputBox_PreviewKeyDown" AutomationProperties.Name="给 Agent 的消息" />
                <Button x:Name="SendButton" Grid.Column="1" Style="{StaticResource AccentActionButton}" Padding="12,8" VerticalAlignment="Bottom" Click="Send_Click"
                        ToolTipService.ToolTip="发送" AutomationProperties.Name="发送">
                    <FontIcon x:Name="SendIcon" Glyph="&#xE724;" FontSize="14" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
