<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InfiniteCanvas.App.Board.PromptPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="Shell" Style="{StaticResource FloatingPanel}" Padding="14,10" Width="540">
        <!-- Parameters hang off the panel's right edge (bottom aligned) so they never cover the prompt. -->
        <FlyoutBase.AttachedFlyout>
            <Flyout x:Name="ParamsFlyout" Placement="RightEdgeAlignedBottom" Opening="ParamsFlyout_Opening" Closed="ParamsFlyout_Closed">
                <ScrollViewer MaxHeight="460" Width="340">
                    <StackPanel x:Name="ParamsPanel" Spacing="4" Padding="0,0,12,0" />
                </ScrollViewer>
            </Flyout>
        </FlyoutBase.AttachedFlyout>
        <Grid>
            <!-- A picture that already has content starts as one line under it; a click or Enter opens the whole panel. -->
            <Grid x:Name="CollapsedRow" ColumnSpacing="10" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="CollapsedOpen" Style="{StaticResource ToolbarButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0,6"
                        AutomationProperties.Name="展开提示词面板" Click="Collapsed_Click">
                    <TextBlock x:Name="CollapsedText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>
                <Button x:Name="CollapsedGenerate" Grid.Column="1" Style="{StaticResource AccentActionButton}" AllowFocusOnInteraction="False" Click="Generate_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:Name="CollapsedIcon" Glyph="&#xE768;" FontSize="13" />
                        <TextBlock x:Name="CollapsedGenerateText" Text="生成" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- One box, like a chat composer: inputs and status on top, the prompt, then model, parameters, cost and the generate button. -->
            <StackPanel x:Name="FullPanel" Spacing="6">
                <Grid x:Name="TopLine" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <SelectorBar x:Name="ModeBar" SelectionChanged="ModeBar_SelectionChanged" Padding="0" Margin="-4,-4,0,-4" VerticalAlignment="Center">
                        <SelectorBarItem Text="图片" Tag="Image"><SelectorBarItem.Icon><FontIcon Glyph="&#xEB9F;" Foreground="{ThemeResource KindImageBrush}" /></SelectorBarItem.Icon></SelectorBarItem>
                        <SelectorBarItem Text="文本" Tag="Text"><SelectorBarItem.Icon><FontIcon Glyph="&#xE8D2;" Foreground="{ThemeResource KindTextBrush}" /></SelectorBarItem.Icon></SelectorBarItem>
                        <SelectorBarItem Text="音频" Tag="Audio"><SelectorBarItem.Icon><FontIcon Glyph="&#xE8D6;" Foreground="{ThemeResource KindAudioBrush}" /></SelectorBarItem.Icon></SelectorBarItem>
                    </SelectorBar>
                    <!-- Connected inputs: image thumbnails plus a count of other inputs. -->
                    <StackPanel x:Name="InputsPanel" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <StackPanel x:Name="InputThumbs" Orientation="Horizontal" Spacing="4" />
                        <TextBlock x:Name="InputsText" VerticalAlignment="Center" Margin="4,0,0,0" Style="{StaticResource SecondaryCaption}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <!-- Marks left on this picture by 局部编辑 (opened from the command bar or the menu); only shown while there are some. -->
                        <StackPanel x:Name="MarksRow" Orientation="Horizontal" Spacing="2" Visibility="Collapsed">
                            <TextBlock x:Name="MarksText" VerticalAlignment="Center" MaxWidth="190" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Style="{StaticResource SecondaryCaption}" />
                            <HyperlinkButton Content="清除标注" Padding="6,2" Click="ClearMarks_Click" />
                        </StackPanel>
                        <!-- Missing model or API key, shown before the user presses generate. -->
                        <StackPanel x:Name="HintRow" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                            <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="HintText" VerticalAlignment="Center" MaxWidth="230" TextTrimming="CharacterEllipsis" Style="{StaticResource SecondaryCaption}" />
                            <HyperlinkButton Content="去设置" Padding="6,2" Click="OpenSettings_Click" />
                        </StackPanel>
                    </StackPanel>
                    <!-- Model notes, recognised text and the reference note: in the tooltip, not in the way. -->
                    <Button x:Name="InfoButton" Grid.Column="3" Style="{StaticResource ToolbarButton}" Padding="8,4" MinHeight="28" Visibility="Collapsed"
                            AutomationProperties.Name="模型说明与识别文字">
                        <FontIcon Glyph="&#xE946;" FontSize="14" />
                    </Button>
                </Grid>
                <TextBox x:Name="PromptBox" AutomationProperties.Name="提示词" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="220" Padding="0,4"
                         Background="Transparent" BorderThickness="0"
                         PlaceholderText="描述想要生成的内容，Ctrl+Enter 开始生成" TextChanged="PromptBox_TextChanged" PreviewKeyDown="PromptBox_PreviewKeyDown"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <!-- The box is the panel itself: no field border or fill of its own, also while hovered and focused. -->
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                    </TextBox.Resources>
                </TextBox>

                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ModelBox" MinWidth="150" MaxWidth="190" PlaceholderText="选择模型" SelectionChanged="ModelBox_SelectionChanged" />
                    <Button x:Name="ParamsButton" Grid.Column="1" Style="{StaticResource ActionButton}" Padding="12,7" AllowFocusOnInteraction="False"
                            ToolTipService.ToolTip="生成参数" AutomationProperties.Name="生成参数" Click="Params_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE9E9;" FontSize="13" />
                            <TextBlock x:Name="ParamsText" Text="参数" MaxWidth="130" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource ActionButton}" Padding="10,7" AllowFocusOnInteraction="False"
                            ToolTipService.ToolTip="提示词库" AutomationProperties.Name="提示词库" Click="PromptLibrary_Click">
                        <FontIcon Glyph="&#xE734;" FontSize="13" />
                    </Button>
                    <!-- Expected cost of the next image run, updated as the model, parameters and prompt change; the whole text is in the tooltip. -->
                    <TextBlock x:Name="EstimateText" Grid.Column="4" Visibility="Collapsed" VerticalAlignment="Center" MaxWidth="150" TextTrimming="CharacterEllipsis" MaxLines="1"
                               Style="{StaticResource SecondaryCaption}" />
                    <Button x:Name="GenerateButton" Grid.Column="5" Style="{StaticResource AccentActionButton}" AllowFocusOnInteraction="False" Click="Generate_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="GenerateIcon" Glyph="&#xE768;" FontSize="13" />
                            <TextBlock x:Name="GenerateText" Text="生成" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
