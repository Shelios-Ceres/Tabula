<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InfiniteCanvas.App.Board.PromptPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="Shell" Style="{StaticResource FloatingPanel}" Padding="14,12" Width="480">
        <!-- Parameters hang off the panel's right edge (bottom aligned) so they never cover the prompt. -->
        <FlyoutBase.AttachedFlyout>
            <Flyout x:Name="ParamsFlyout" Placement="RightEdgeAlignedBottom" Opening="ParamsFlyout_Opening" Closed="ParamsFlyout_Closed">
                <ScrollViewer MaxHeight="460" Width="340">
                    <StackPanel x:Name="ParamsPanel" Spacing="4" Padding="0,0,12,0" />
                </ScrollViewer>
            </Flyout>
        </FlyoutBase.AttachedFlyout>
        <StackPanel Spacing="8">
            <Grid x:Name="HeaderRow">
                <SelectorBar x:Name="ModeBar" SelectionChanged="ModeBar_SelectionChanged" Padding="0" Margin="-4,-4,0,0">
                    <SelectorBarItem Text="图片" Tag="Image"><SelectorBarItem.Icon><FontIcon Glyph="&#xEB9F;" Foreground="{ThemeResource KindImageBrush}" /></SelectorBarItem.Icon></SelectorBarItem>
                    <SelectorBarItem Text="文本" Tag="Text"><SelectorBarItem.Icon><FontIcon Glyph="&#xE8D2;" Foreground="{ThemeResource KindTextBrush}" /></SelectorBarItem.Icon></SelectorBarItem>
                    <SelectorBarItem Text="音频" Tag="Audio"><SelectorBarItem.Icon><FontIcon Glyph="&#xE8D6;" Foreground="{ThemeResource KindAudioBrush}" /></SelectorBarItem.Icon></SelectorBarItem>
                </SelectorBar>
                <!-- Connected inputs: image thumbnails plus a count of other inputs. -->
                <StackPanel x:Name="InputsPanel" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel x:Name="InputThumbs" Orientation="Horizontal" Spacing="4" />
                    <TextBlock x:Name="InputsText" VerticalAlignment="Center" Margin="4,0,0,0" Style="{StaticResource SecondaryCaption}" />
                </StackPanel>
            </Grid>
            <TextBox x:Name="PromptBox" AutomationProperties.Name="提示词" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="220"
                     PlaceholderText="描述想要生成的内容，Ctrl+Enter 开始生成" TextChanged="PromptBox_TextChanged" PreviewKeyDown="PromptBox_PreviewKeyDown"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
            <!-- Missing model or API key, shown before the user presses generate. -->
            <Grid x:Name="HintRow" ColumnSpacing="6" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                <TextBlock x:Name="HintText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource SecondaryCaption}" />
                <HyperlinkButton Grid.Column="2" Content="去设置" Padding="6,2" Click="OpenSettings_Click" />
            </Grid>
            <!-- Marks left on this picture by 局部编辑 (opened from the command bar or the menu); only shown while there are some. -->
            <Grid x:Name="MarksRow" ColumnSpacing="6" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="MarksText" VerticalAlignment="Center" Style="{StaticResource SecondaryCaption}" />
                <Button Grid.Column="1" Style="{StaticResource ToolbarButton}" Padding="10,4" MinHeight="28" Content="清除标注" Click="ClearMarks_Click" />
            </Grid>
            <TextBlock x:Name="ModelText" Visibility="Collapsed" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True"
                       Style="{StaticResource SecondaryCaption}" />
            <!-- Expected cost of the next image run, updated as the model, parameters and prompt change. -->
            <TextBlock x:Name="EstimateText" Visibility="Collapsed" TextWrapping="Wrap" Style="{StaticResource SecondaryCaption}"
                       ToolTipService.ToolTip="按官方价格或上次同样设置的实际用量估算，仅供参考：不含思考 token、免费额度和优惠" />

            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ModelBox" HorizontalAlignment="Stretch" PlaceholderText="选择模型" SelectionChanged="ModelBox_SelectionChanged" />
                <Button Grid.Column="1" Style="{StaticResource ActionButton}" Padding="10,7" AllowFocusOnInteraction="False"
                        ToolTipService.ToolTip="提示词库" AutomationProperties.Name="提示词库" Click="PromptLibrary_Click">
                    <FontIcon Glyph="&#xE734;" FontSize="13" />
                </Button>
                <Button x:Name="ParamsButton" Grid.Column="2" Style="{StaticResource ActionButton}" Padding="12,7" AllowFocusOnInteraction="False"
                        ToolTipService.ToolTip="生成参数" AutomationProperties.Name="生成参数" Click="Params_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE9E9;" FontSize="13" />
                        <TextBlock x:Name="ParamsText" Text="参数" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
                <Button x:Name="GenerateButton" Grid.Column="3" Style="{StaticResource AccentActionButton}" AllowFocusOnInteraction="False" Click="Generate_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:Name="GenerateIcon" Glyph="&#xE768;" FontSize="13" />
                        <TextBlock x:Name="GenerateText" Text="生成" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
