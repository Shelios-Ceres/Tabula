<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InfiniteCanvas.App.Board.CanvasView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:win2d="using:Microsoft.Graphics.Canvas.UI.Xaml">
    <Grid x:Name="Root" Background="{ThemeResource CanvasBackgroundBrush}" IsTabStop="True" AllowDrop="True" UseSystemFocusVisuals="False"
          PointerPressed="Root_PointerPressed" PointerMoved="Root_PointerMoved" PointerReleased="Root_PointerReleased"
          PointerCanceled="Root_PointerReleased" PointerCaptureLost="Root_PointerCaptureLost" PointerWheelChanged="Root_PointerWheelChanged"
          ContextRequested="Root_ContextRequested" DoubleTapped="Root_DoubleTapped" KeyDown="Root_KeyDown" KeyUp="Root_KeyUp"
          DragOver="Root_DragOver" Drop="Root_Drop" SizeChanged="Root_SizeChanged">
        <win2d:CanvasControl x:Name="Backdrop" Draw="Backdrop_Draw" IsHitTestVisible="False" ClearColor="Transparent" />
        <Canvas x:Name="World">
            <Canvas.RenderTransform>
                <CompositeTransform x:Name="WorldTransform" />
            </Canvas.RenderTransform>
        </Canvas>
        <win2d:CanvasControl x:Name="Overlay" Draw="Overlay_Draw" IsHitTestVisible="False" ClearColor="Transparent" />
        <!-- XMind-style progressive blur along the top and bottom edge, with every glass material (DrawFade). -->
        <win2d:CanvasControl x:Name="TopFade" Draw="TopFade_Draw" IsHitTestVisible="False" ClearColor="Transparent" VerticalAlignment="Top" Height="110" />
        <win2d:CanvasControl x:Name="BottomFade" Draw="BottomFade_Draw" IsHitTestVisible="False" ClearColor="Transparent" VerticalAlignment="Bottom" Height="110" />
        <StackPanel x:Name="EmptyHint" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed">
            <FontIcon Glyph="&#xE790;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="开始创作" HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="把图片、视频或音频拖进窗口，或双击、右键空白处新建节点&#x0a;选中节点后，命令会出现在它旁边" />
        </StackPanel>
        <Canvas x:Name="ScreenLayer" />
    </Grid>
</UserControl>
