<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>InfiniteCanvas.App</RootNamespace>
    <AssemblyName>InfiniteCanvas</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Rendered from Assets/Logo.svg; used for the exe, the taskbar and the title bar. -->
    <ApplicationIcon>Assets/AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged and self-contained: runs straight from the build output without installing the Windows App SDK runtime. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- Program.cs owns Main so the exe can also run as the agents' MCP bridge. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Assets/** is content by default; the SVG is only the source of the icon files. -->
    <Content Remove="Assets/Logo.svg" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\InfiniteCanvas.Core\InfiniteCanvas.Core.csproj" />
    <ProjectReference Include="..\InfiniteCanvas.Providers\InfiniteCanvas.Providers.csproj" />
    <ProjectReference Include="..\InfiniteCanvas.Agents\InfiniteCanvas.Agents.csproj" />
  </ItemGroup>
</Project>
